<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.17763.0;net48</TargetFrameworks>
    <RootNamespace>CredentialManagement</RootNamespace>
    <AssemblyName>CredentialManagement</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- Win32 names intentionally mirror the native API; legacy UI entry points require mutable buffers. -->
    <NoWarn>$(NoWarn);CA1707;CA1838;CS1591</NoWarn>
    <!-- These modern throw helpers are unavailable to the shared net48 source. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net10.0-windows10.0.17763.0'">$(NoWarn);CA1510;CA1513</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CredentialManagement</PackageId>
    <VersionPrefix>2.0.0</VersionPrefix>
    <Authors>iLya Lozovyy and contributors</Authors>
    <Description>Modern .NET API for the native Windows Credential Manager and credential-provider dialogs.</Description>
    <PackageTags>windows;credentials;credential-manager;win32;security</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ilyalozovyy/credentialmanagement</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
